# =================================================================
# x402 Level 2_b 极端环境生存决策系统 —— 服务端环境变量配置
# 【安全铁律】服务端仅作为收款方与智能体服务商，绝对严禁配置任何私钥！
# =================================================================

# 服务端公开收款钱包地址 (EVM 格式，用于接收客户端支付的 USDC)
PAY_TO=0xdcD7DAFafb0EF3d50bDdB480Dbd503Fa6D1B6C09

# 本地运行端口
PORT=3000

# x402 Facilitator 协调器地址 (默认官方测试网协调器)
FACILITATOR_URL=https://x402.org/facilitator

# ================= 方案 B：DeepSeek 智能体模型调用配置 =================
# 【重要配置】请在此处填入您的 DeepSeek 官方 API Key (如: sk-...)
# 系统全流程 100% 由 DeepSeek 驱动，若留空或配置错误将直接明确报错“API无效”
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek 官方兼容端点
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 默认模型名称 (deepseek-chat 或 deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat
